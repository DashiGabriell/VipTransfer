# Copie para .env local OU configure no painel da Vercel (Project → Settings → Environment Variables).
# Todas as variáveis VITE_* entram no bundle do browser — nunca coloque service_role aqui.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# ou legado:
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Slug da organização padrão quando o host não resolve tenant
VITE_DEFAULT_TENANT_SLUG=jmd

# Opcional — webhook n8n para alerta de reserva (browser)
VITE_N8N_WEBHOOK_URL=

# Origem pública para links no WhatsApp (ex.: convite/demanda). Em localhost
# o app usa https://jmdtrasnfer.vercel.app se esta variável estiver vazia.
# VITE_PUBLIC_SITE_URL=https://jmdtrasnfer.vercel.app

# Convite de motorista: configure no Supabase (Edge secret), NÃO no Vite:
#   N8N_DRIVER_INVITE_WEBHOOK_URL=https://SEU-N8N/webhook/jmd-driver-invite
#   npx supabase secrets set N8N_DRIVER_INVITE_WEBHOOK_URL=...

# Distância no formulário: Photon (geocode) + OSRM (rota) — sem chave

# PWA / Web Push (opcional — chave pública VAPID para push futuro)
# VITE_VAPID_PUBLIC_KEY=

# --- Vercel ---
# Production / Preview / Development: defina pelo menos
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PUBLISHABLE_KEY
#   VITE_DEFAULT_TENANT_SLUG
# Root Directory no dashboard Vercel: `web`
# (o rewrite SPA fica em web/vercel.json — sem isso, /admin/* vira 404).

# Na raiz do repo (.env) só para CLI local:
# SUPABASE_TOKEN=sbp_xxx

# ---------------------------------------------------------------------------
# Asaas (Edge Functions — NUNCA VITE_* / nunca no browser)
# Configure com: npx supabase secrets set KEY=value
# ---------------------------------------------------------------------------
# ASAAS_API_KEY=          # API Key sandbox ou produção
# ASAAS_ENV=sandbox       # sandbox | production
# ASAAS_API_URL=          # opcional; default conforme ASAAS_ENV
# ASAAS_CHECKOUT_URL=     # opcional; página do checkout
# ASAAS_WEBHOOK_TOKEN=    # authToken do webhook (≥32 chars) → header asaas-access-token
# SITE_URL=https://jmdtrasnfer.vercel.app  # callbacks success/cancel/expired
#
# Webhook URL no painel Asaas:
#   https://<PROJECT_REF>.supabase.co/functions/v1/asaas-webhook
# Eventos: CHECKOUT_PAID, CHECKOUT_EXPIRED, CHECKOUT_CANCELED
