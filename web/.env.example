# Copie para .env local OU configure no painel da Vercel (Project → Settings → Environment Variables).
# Todas as variáveis VITE_* entram no bundle do browser — nunca coloque service_role aqui.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# ou legado:
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Slug da organização padrão quando o host não resolve tenant
VITE_DEFAULT_TENANT_SLUG=jmd

# Opcional — webhook n8n para leads / notificações
VITE_N8N_WEBHOOK_URL=

# Distância no formulário: Photon (geocode) + OSRM (rota) — sem chave

# PWA / Web Push (opcional — chave pública VAPID para push futuro)
# VITE_VAPID_PUBLIC_KEY=

# --- Vercel ---
# Production / Preview / Development: defina pelo menos
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PUBLISHABLE_KEY
#   VITE_DEFAULT_TENANT_SLUG
# Root Directory no dashboard Vercel: `web`
# (o rewrite SPA fica em web/vercel.json — sem isso, /admin/* vira 404).

# Na raiz do repo (.env) só para CLI local:
# SUPABASE_TOKEN=sbp_xxx
